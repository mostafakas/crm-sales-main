{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALMaster CRM",
  "version": "0.1.0",
  "identifier": "com.almaster.crm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3004",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "ALMaster CRM",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
